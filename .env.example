# Copy to .env and change every value. Never commit .env.
POSTGRES_PASSWORD=change-me
# Required. Encrypts sensitive data in the database; generate with: openssl rand -base64 32
# Back it up somewhere safe: if lost, that data cannot be recovered.
DBM_MASTER_KEY=
# Encrypt API payloads on top of TLS (on or off). Needs https or localhost in the browser.
DBM_E2EE=on
# Local development only (docker compose --profile dev up db)
DATABASE_URL=postgres://dbm:change-me@127.0.0.1:5433/dbm
# Set to false only when the UI is served over plain http on a trusted machine.
DBM_COOKIE_SECURE=true
# Optional Cloudflare Turnstile on sign-in. Set both keys or neither; empty means off.
# DBM_TURNSTILE_HOSTNAMES: comma separated hostnames you open DB Manager on, also listed in the widget.
# Do not include localhost in production.
# Needs internet access from the browser and the server. Locked out? Empty both and restart.
DBM_TURNSTILE_SITE_KEY=
DBM_TURNSTILE_SECRET_KEY=
DBM_TURNSTILE_HOSTNAMES=
# One-time token from the Agents page, needed on the agent's first start.
DBM_ENROLL_TOKEN=

# HTTPS through Hanoey (docker compose --profile https up -d). Then also set DBM_TRUST_PROXY=true.
DBM_TRUST_PROXY=false
DBM_HTTPS_BIND=127.0.0.1
